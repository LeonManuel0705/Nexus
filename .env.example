# Google OAuth credentials
# To get these, go to Google Cloud Console > APIs & Services > Credentials
# Create a Web Application OAuth 2.0 Client ID with redirect URI: http://localhost:5050/api/email/google/oauth-callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/email/google/oauth-callback

# Project settings
GOOGLE_PROJECT_ID=your-project-id
