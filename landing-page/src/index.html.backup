              </div>
              <div class="extended-scrim"></div>
              <div class="extended-gradient-overlay"></div>
              <div class="extended-bottom-fade"></div>
            </div>

            <!-- HERO Section -->
            <section id="hero-section" class="hero-section relative overflow-hidden">
              <!-- Abstract floating shapes -->
            <div class="absolute top-20 right-0 w-96 h-96 bg-nexus-purple/10 rounded-full blur-[100px] pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-nexus-blue/10 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="hero-content-wrapper max-w-7xl mx-auto px-6 relative z-10 text-center w-full">

              <h1 class="text-5xl md:text-7xl font-bold font-display leading-[1.1] mb-6 hero-entrance hero-entrance-delay-1">
                ${t('home.hero_title_1')}<br/>
                <span class="text-gradient">${t('home.hero_title_2')}</span>
              </h1>

              <p class="text-lg md:text-xl text-nexus-muted max-w-2xl mx-auto mb-8 hero-entrance hero-entrance-delay-2">
                ${t('home.hero_subtitle')}
              </p>

              <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-48 hero-entrance hero-entrance-delay-3">
                <a href="/download" onclick="handleNav(event, '/download')" class="w-full sm:w-auto px-8 py-4 rounded-full btn-primary font-bold text-lg shadow-xl shadow-nexus-purple/20">
                  ${t('home.hero_cta_download')}
                </a>
                <button onclick="scrollToId('features')" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white border border-gray-200 text-nexus-text font-bold text-lg hover:border-nexus-purple hover:text-nexus-purple transition-colors">
                  ${t('home.hero_cta_features')}
                </button>
              </div>

              <!-- Parallax Floating Interface -->
              <div class="relative max-w-5xl mx-auto hero-entrance hero-entrance-delay-4">
                <div class="glass-panel p-2 rounded-3xl md:rounded-[2rem]">
                  <img
                    src="${optimizeUrl(data.assets.home_hero, 1200)}"
                    alt="Nexus Dashboard Interface"
                    class="w-full h-auto rounded-2xl md:rounded-[1.5rem] shadow-sm"
                  />
                </div>
                <!-- Floating Elements -->
                <div class="absolute -right-8 top-1/4 hidden lg:block float-animation" style="animation-delay: 1s;">
                   <div class="glass-panel p-4 rounded-2xl flex items-center gap-3">
                     <div class="p-2 bg-green-100 rounded-full text-green-600"><i data-lucide="check" class="w-5 h-5"></i></div>
                     <div><p class="text-sm font-bold">${t('home.hero_float_physics')}</p><p class="text-xs text-nexus-muted">${t('home.hero_float_physics_sub')}</p></div>
                   </div>
                </div>
                <div class="absolute -left-8 bottom-1/4 hidden lg:block float-animation" style="animation-delay: 2s;">
                   <div class="glass-panel p-4 rounded-2xl flex items-center gap-3">
                     <div class="p-2 bg-blue-100 rounded-full text-blue-600"><i data-lucide="train" class="w-5 h-5"></i></div>
                     <div><p class="text-sm font-bold">${t('home.hero_float_u2')}</p><p class="text-xs text-nexus-muted">${t('home.hero_float_u2_sub')}</p></div>
                   </div>
                </div>
              </div>
            </div>
          </section>

          <!-- PROBLEM / SOLUTION - within extended hero background -->
