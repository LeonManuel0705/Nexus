      function renderPrivacy() {
        app.innerHTML = `
           <!-- HERO -->
           <section class="pt-32 pb-20 bg-white">
             <div class="max-w-7xl mx-auto px-6">
               <div class="grid md:grid-cols-2 gap-12 items-center">
                 <div class="reveal">
                   <h1 class="text-5xl font-bold mb-6 font-display">${t('privacy.hero_title')}</h1>
                   <p class="text-xl text-nexus-muted">${t('privacy.hero_desc')}</p>
                 </div>
                 <div class="reveal stagger-1">
                   <img src="${optimizeUrl(data.assets.privacy_hero, 800)}" alt="Privacy Abstract" class="w-full h-auto rounded-3xl">
                 </div>
               </div>
             </div>
           </section>

           <!-- OFFLINE ADVANTAGE - Switching Highlight Section -->
           <section class="privacy-highlight-section" id="privacy-highlights">
             <div class="privacy-highlight-container">
               <div class="privacy-highlight-grid">
                 <!-- Left: Sticky intro -->
                 <div class="privacy-highlight-sticky">
                   <div class="privacy-highlight-intro reveal">
                     <h2 class="font-display">${t('privacy.offline_title')} <span class="text-gradient">${t('privacy.offline_title_gradient')}</span></h2>
                     <p>${t('privacy.offline_desc')}</p>
                   </div>
                 </div>

                 <!-- Right: Highlight items with indicator -->
                 <div class="privacy-highlight-items reveal stagger-1">
                   <div class="privacy-indicator-track">
                     <div class="privacy-indicator-bar" id="privacy-indicator"></div>
                   </div>

                   <div class="privacy-highlight-item active" data-highlight="0">
                     <div class="privacy-item-icon icon-speed">
                       <i data-lucide="zap" class="w-6 h-6"></i>
                     </div>
                     <h3 class="privacy-item-title">${t('privacy.speed_title')}</h3>
                     <p class="privacy-item-desc">${t('privacy.speed_desc')}</p>
                   </div>

                   <div class="privacy-highlight-item muted" data-highlight="1">
                     <div class="privacy-item-icon icon-offline">
                       <i data-lucide="wifi-off" class="w-6 h-6"></i>
                     </div>
                     <h3 class="privacy-item-title">${t('privacy.subway_title')}</h3>
                     <p class="privacy-item-desc">${t('privacy.subway_desc')}</p>
                   </div>

                   <div class="privacy-highlight-item muted" data-highlight="2">
                     <div class="privacy-item-icon icon-secure">
                       <i data-lucide="shield-check" class="w-6 h-6"></i>
                     </div>
                     <h3 class="privacy-item-title">${t('privacy.breach_title')}</h3>
                     <p class="privacy-item-desc">${t('privacy.breach_desc')}</p>
                   </div>
                 </div>
               </div>
             </div>
           </section>

           <!-- TRUST BADGES -->
           <section class="py-24 bg-white">
             <div class="max-w-4xl mx-auto px-6">
               <div class="flex flex-wrap justify-center gap-12 md:gap-24 opacity-70">
                 <div class="flex flex-col items-center gap-3 reveal stagger-1">
                   <i data-lucide="hard-drive" class="w-12 h-12 text-nexus-text"></i>
                   <span class="font-bold">${t('privacy.trust_local')}</span>
                 </div>
                 <div class="flex flex-col items-center gap-3 reveal stagger-2">
                   <i data-lucide="shield-ban" class="w-12 h-12 text-nexus-text"></i>
                   <span class="font-bold">${t('privacy.trust_tracking')}</span>
                 </div>
                 <div class="flex flex-col items-center gap-3 reveal stagger-3">
                   <i data-lucide="ban" class="w-12 h-12 text-nexus-text"></i>
                   <span class="font-bold">${t('privacy.trust_ads')}</span>
                 </div>
               </div>
             </div>
           </section>

           <!-- CTA -->
           <section class="py-24 bg-nexus-text text-white text-center">
             <div class="max-w-3xl mx-auto px-6 reveal">
               <h2 class="text-4xl font-bold mb-8">${t('privacy.cta_title')}</h2>
               <a href="/download" onclick="handleNav(event, '/download')" class="inline-block px-10 py-4 rounded-full bg-white text-nexus-text font-bold text-lg hover:bg-gray-100 transition-colors">
                 ${t('privacy.cta_button')}
               </a>
             </div>
           </section>
        `;
      }

      function renderDownload() {
        app.innerHTML = `
          <!-- HERO -->
          <section class="pt-32 pb-16 text-center">
            <div class="max-w-3xl mx-auto px-6 reveal">
              <h1 class="text-5xl font-bold mb-4 font-display">${t('download.hero_title')}</h1>
              <p class="text-xl text-nexus-muted">${t('download.hero_desc')}</p>
            </div>
          </section>

          <!-- FEATURES + PLATFORMS -->
          <section class="pb-24">
            <div class="max-w-6xl mx-auto px-6">
              <!-- Features card -->
              <div class="glass-panel bg-white p-8 md:p-12 rounded-[2.5rem] border-2 border-nexus-purple/10 relative overflow-hidden mb-16 max-w-2xl mx-auto reveal">
                <div class="absolute top-0 right-0 bg-nexus-purple text-white px-6 py-2 rounded-bl-2xl font-bold">${t('download.plan_badge')}</div>
                <h2 class="text-3xl font-bold mb-8">${t('download.plan_title')}</h2>
                <ul class="space-y-4">
                  <li class="flex items-center gap-3"><i data-lucide="check-circle" class="text-green-500 w-6 h-6"></i> <span class="text-lg">${t('download.plan_tasks')}</span></li>
                  <li class="flex items-center gap-3"><i data-lucide="check-circle" class="text-green-500 w-6 h-6"></i> <span class="text-lg">${t('download.plan_academic')}</span></li>
                  <li class="flex items-center gap-3"><i data-lucide="check-circle" class="text-green-500 w-6 h-6"></i> <span class="text-lg">${t('download.plan_transit')}</span></li>
                  <li class="flex items-center gap-3"><i data-lucide="check-circle" class="text-green-500 w-6 h-6"></i> <span class="text-lg">${t('download.plan_workout')}</span></li>
                  <li class="flex items-center gap-3"><i data-lucide="check-circle" class="text-green-500 w-6 h-6"></i> <span class="text-lg">${t('download.plan_backup')}</span></li>
                </ul>
              </div>

              <!-- Platform grid -->
              <h2 class="text-3xl font-bold text-center mb-12 reveal">${t('download.platforms_title')}</h2>
              <!-- Top row: 3 cards -->
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="platform-grid">

                <!-- Android -->
                <div id="android" class="glass-panel bg-white p-6 rounded-2xl border border-nexus-purple/10 hover:border-nexus-purple/30 transition-all reveal">
                  <div class="flex items-center gap-3 mb-3">
                    <img src="/icons/android.png" alt="Android" class="w-10 h-10 object-contain">
                    <h3 class="font-bold text-lg">Android</h3>
                  </div>
                  <p class="text-sm text-nexus-muted mb-4">${t('download.desc_android')}</p>
                  <a href="/downloads/Nexus.apk" class="block w-full py-3 rounded-xl border-2 border-nexus-text text-nexus-text font-bold text-center hover:bg-gray-50 transition-colors">${t('download.btn_android')}</a>
                  <p class="text-center text-xs text-nexus-muted mt-2">${t('download.req_android')}</p>
                </div>

                <!-- iOS / iPadOS -->
                <div id="ios" class="glass-panel bg-white p-6 rounded-2xl border border-nexus-purple/10 hover:border-nexus-purple/30 transition-all reveal stagger-1">
                  <div class="flex items-center gap-3 mb-3">
                    <img src="/icons/iOS-Logo.png" alt="iOS" class="w-10 h-10 object-contain">
                    <h3 class="font-bold text-lg">iOS / iPadOS</h3>
                  </div>
                  <p class="text-sm text-nexus-muted mb-4">${t('download.desc_ios')}</p>
                  <a href="/pwa/index.html" class="block w-full py-3 rounded-xl border-2 border-nexus-text text-nexus-text font-bold text-center hover:bg-gray-50 transition-colors">${t('download.btn_ios')}</a>
                  <p class="text-center text-xs text-nexus-muted mt-2">${t('download.req_ios')}</p>
                </div>

                <!-- macOS -->
                <div id="macos" class="glass-panel bg-white p-6 rounded-2xl border border-nexus-purple/10 hover:border-nexus-purple/30 transition-all reveal stagger-2">
                  <div class="flex items-center gap-3 mb-3">
                    <img src="/icons/macOS-logo.png" alt="macOS" class="w-10 h-10 object-contain">
                    <h3 class="font-bold text-lg">macOS</h3>
                  </div>
                  <p class="text-sm text-nexus-muted mb-4">${t('download.desc_macos')}</p>
                  <a href="/downloads/Nexus-macOS.zip" class="block w-full py-3 rounded-xl border-2 border-nexus-text text-nexus-text font-bold text-center hover:bg-gray-50 transition-colors">${t('download.btn_macos')}</a>
                  <p class="text-center text-xs text-nexus-muted mt-2">${t('download.req_macos')}</p>
                </div>

              </div>

              <!-- Bottom row: 2 cards centered -->
              <div class="grid sm:grid-cols-2 gap-6 max-w-[calc(66.666%+0.75rem)] mx-auto mt-6">

                <!-- Windows -->
                <div id="windows" class="glass-panel bg-white p-6 rounded-2xl border border-nexus-purple/10 hover:border-nexus-purple/30 transition-all reveal stagger-3">
                  <div class="flex items-center gap-3 mb-3">
                    <img src="/icons/Windows-logo.png" alt="Windows" class="w-10 h-10 object-contain">
                    <h3 class="font-bold text-lg">Windows</h3>
                  </div>
                  <p class="text-sm text-nexus-muted mb-4">${t('download.desc_windows')}</p>
                  <a href="/pwa/index.html" class="block w-full py-3 rounded-xl border-2 border-nexus-text text-nexus-text font-bold text-center hover:bg-gray-50 transition-colors">${t('download.btn_windows')}</a>
                  <p class="text-center text-xs text-nexus-muted mt-2">${t('download.req_windows')}</p>
                </div>

                <!-- Linux -->
                <div id="linux" class="glass-panel bg-white p-6 rounded-2xl border border-nexus-purple/10 hover:border-nexus-purple/30 transition-all reveal stagger-4">
                  <div class="flex items-center gap-3 mb-3">
                    <img src="/icons/Linux-logo.png" alt="Linux" class="w-10 h-10 object-contain">
                    <h3 class="font-bold text-lg">Linux</h3>
                  </div>
                  <p class="text-sm text-nexus-muted mb-4">${t('download.desc_linux')}</p>
                  <a href="/pwa/index.html" class="block w-full py-3 rounded-xl border-2 border-nexus-text text-nexus-text font-bold text-center hover:bg-gray-50 transition-colors">${t('download.btn_linux')}</a>
                  <p class="text-center text-xs text-nexus-muted mt-2">${t('download.req_linux')}</p>
                </div>

              </div>
            </div>
          </section>

          <!-- INSTALLATION FAQ -->
          <section class="py-24 bg-gray-50">
            <div class="max-w-3xl mx-auto px-6">
              <h2 class="text-3xl font-bold text-center mb-12 reveal">${t('download.faq_title')}</h2>
              <div class="space-y-6">
                <div class="reveal stagger-1">
                  <h3 class="font-bold text-lg mb-2">${t('download.faq_q1')}</h3>
                  <p class="text-nexus-muted">${t('download.faq_a1')}</p>
                </div>
                <div class="reveal stagger-2">
                  <h3 class="font-bold text-lg mb-2">${t('download.faq_q2')}</h3>
                  <p class="text-nexus-muted">${t('download.faq_a2')}</p>
                </div>
                <div class="reveal stagger-3">
                  <h3 class="font-bold text-lg mb-2">${t('download.faq_q3')}</h3>
                  <p class="text-nexus-muted">${t('download.faq_a3')}</p>
                </div>
              </div>
            </div>
          </section>
        `;

        // Scroll to platform anchor if hash present
        if (window.location.hash) {
          const target = document.querySelector(window.location.hash);
          if (target) setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
        }
      }

      function renderAbout() {
        app.innerHTML = `
