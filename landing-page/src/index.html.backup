        >
          <img
            src="https://res.cloudinary.com/du5fldub3/image/upload/e_trim/v1771950089/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/logo-iter1-nobg.png"
            alt="Nexus Logo"
            class="h-7 w-auto object-contain"
          />
          <span class="font-display font-bold text-2xl tracking-tight text-nexus-text group-hover:text-nexus-purple transition-colors">Nexus</span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" onclick="handleNav(event, '/')" class="text-sm font-medium text-nexus-text hover:text-nexus-purple transition-colors" data-nav data-i18n="nav.home">Home</a>
          <a href="/features" onclick="handleNav(event, '/features')" class="text-sm font-medium text-nexus-text hover:text-nexus-purple transition-colors" data-nav data-i18n="nav.features">Features</a>
          <a href="/privacy-philosophy" onclick="handleNav(event, '/privacy-philosophy')" class="text-sm font-medium text-nexus-text hover:text-nexus-purple transition-colors" data-nav data-i18n="nav.privacy">Privacy</a>
          <a href="/about" onclick="handleNav(event, '/about')" class="text-sm font-medium text-nexus-text hover:text-nexus-purple transition-colors" data-nav data-i18n="nav.about">About</a>
          <a href="/download" onclick="handleNav(event, '/download')" class="px-5 py-2.5 rounded-full bg-nexus-text text-white text-sm font-semibold hover:bg-nexus-purple transition-all shadow-lg hover:shadow-nexus-purple/30" data-i18n="nav.download">Download</a>
          <button onclick="setLanguage(currentLang === 'de' ? 'en' : 'de')" class="text-sm font-medium text-nexus-muted hover:text-nexus-purple transition-colors px-2 py-1 rounded border border-gray-200" id="lang-toggle">EN</button>
        </div>

        <!-- Mobile Menu Trigger -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-nexus-text focus:outline-none"
          aria-label="Menu"
        >
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>
    </nav>

    <!-- MOBILE MENU OVERLAY -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-[60] transform translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div class="h-20 flex items-center justify-between px-6 border-b border-gray-100">
        <span class="font-display font-bold text-xl text-nexus-purple" data-i18n="nav.menu">MENU</span>
        <button id="close-mobile-menu" class="p-2 text-nexus-text hover:text-nexus-purple transition-colors">
          <i data-lucide="x" class="w-6 h-6"></i>
        </button>
      </div>
      <div class="flex-1 flex flex-col justify-center items-center gap-8 p-6">
        <a href="/" onclick="handleNav(event, '/')" class="text-2xl font-display font-medium text-nexus-text hover:text-nexus-purple" data-i18n="nav.home">Home</a>
        <a href="/features" onclick="handleNav(event, '/features')" class="text-2xl font-display font-medium text-nexus-text hover:text-nexus-purple" data-i18n="nav.features">Features</a>
        <a href="/privacy-philosophy" onclick="handleNav(event, '/privacy-philosophy')" class="text-2xl font-display font-medium text-nexus-text hover:text-nexus-purple" data-i18n="nav.privacy">Privacy</a>
        <a href="/about" onclick="handleNav(event, '/about')" class="text-2xl font-display font-medium text-nexus-text hover:text-nexus-purple" data-i18n="nav.about">About</a>
        <a href="/download" onclick="handleNav(event, '/download')" class="mt-4 px-8 py-3 rounded-full btn-primary text-lg font-semibold shadow-xl" data-i18n="nav.download_free">Download Free</a>
        <button onclick="setLanguage(currentLang === 'de' ? 'en' : 'de')" class="text-lg font-medium text-nexus-muted hover:text-nexus-purple transition-colors px-3 py-1 rounded border border-gray-200 lang-toggle-mobile">EN</button>
      </div>
    </div>

    <main id="app" class="pt-20 min-h-screen">
      <!-- Route content is appended dynamically -->
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-gray-100 pt-16 pb-8 overflow-hidden relative">
      <!-- Mega Watermark -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl pointer-events-none opacity-[0.03] select-none">
        <img src="https://res.cloudinary.com/du5fldub3/image/upload/e_trim/v1771950089/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/logo-iter1-nobg.png" class="w-full" alt="Watermark">
      </div>

      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
          <div class="col-span-1 md:col-span-2">
            <a href="/" class="flex items-center gap-2 mb-6" onclick="handleNav(event, '/')">
              <img src="https://res.cloudinary.com/du5fldub3/image/upload/e_trim/v1771950089/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/logo-iter1-nobg.png" alt="Nexus Logo" class="h-8 w-auto">
              <span class="font-display font-bold text-xl text-nexus-text">Nexus</span>
            </a>
            <p class="text-nexus-muted max-w-sm mb-8" data-i18n="footer.tagline">
              The only productivity app built specifically for students and professionals. Private, offline-first, and completely free.
            </p>
            <div class="flex gap-4">
              <a href="#" class="p-2 rounded-full bg-gray-50 text-nexus-muted hover:bg-nexus-purple hover:text-white transition-colors" style="display:none">
                <i data-lucide="twitter" class="w-5 h-5"></i>
              </a>
              <a href="#" class="p-2 rounded-full bg-gray-50 text-nexus-muted hover:bg-nexus-purple hover:text-white transition-colors" style="display:none">
                <i data-lucide="instagram" class="w-5 h-5"></i>
              </a>
              <a href="https://github.com/LeonManuel0705" target="_blank" rel="noopener noreferrer" class="p-2 rounded-full bg-gray-50 text-nexus-muted hover:bg-nexus-purple hover:text-white transition-colors">
                <i data-lucide="github" class="w-5 h-5"></i>
              </a>
            </div>
          </div>
          
          <div>
            <h4 class="font-display font-bold text-nexus-text mb-6" data-i18n="footer.product">Product</h4>
            <ul class="space-y-4">
              <li><a href="/features" onclick="handleNav(event, '/features')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="nav.features">Features</a></li>
              <li><a href="/privacy-philosophy" onclick="handleNav(event, '/privacy-philosophy')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="nav.privacy">Privacy</a></li>
              <li><a href="/download" onclick="handleNav(event, '/download')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="nav.download">Download</a></li>
            </ul>
