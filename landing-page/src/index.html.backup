              <h2 class="text-3xl font-bold mb-6">${t('about.contact_title')}</h2>
              <p class="text-lg text-white/80 mb-8">${t('about.contact_desc')}</p>
              <a href="mailto:leon.m.toepper@gmail.com?subject=Feedback" class="inline-block px-8 py-3 rounded-full bg-white text-nexus-purple font-bold hover:bg-gray-100 transition-colors">
                ${t('about.contact_button')}
              </a>
            </div>
          </section>
        `;
      }

