          </div>

          <!-- VALUE PROP (PRIVACY) -->
          <section class="py-24 bg-gradient-brand text-white relative overflow-hidden">
            <!-- Background pattern -->
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 30px 30px;"></div>
            
            <div class="max-w-7xl mx-auto px-6 relative z-10">
              <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div class="reveal">
                  <div class="glass-panel bg-white/10 border-white/20 p-8 rounded-3xl backdrop-blur-md">
                    <img src="${optimizeUrl(data.assets.privacy_shield, 600)}" alt="Privacy Shield" class="w-full h-auto drop-shadow-2xl">
                  </div>
                </div>
                <div class="reveal stagger-1">
                  <h2 class="text-4xl md:text-5xl font-bold mb-6">${t('home.privacy_title')}</h2>
                  <p class="text-lg text-white/90 mb-8 leading-relaxed">
                    ${t('home.privacy_desc')}
                  </p>
                  <ul class="space-y-4">
                    <li class="flex items-center gap-3">
                      <div class="p-1 rounded-full bg-white/20"><i data-lucide="check" class="w-4 h-4"></i></div>
                      <span class="font-medium">${t('home.privacy_check1')}</span>
                    </li>
                    <li class="flex items-center gap-3">
                      <div class="p-1 rounded-full bg-white/20"><i data-lucide="check" class="w-4 h-4"></i></div>
                      <span class="font-medium">${t('home.privacy_check2')}</span>
                    </li>
                    <li class="flex items-center gap-3">
                      <div class="p-1 rounded-full bg-white/20"><i data-lucide="check" class="w-4 h-4"></i></div>
                      <span class="font-medium">${t('home.privacy_check3')}</span>
                    </li>
                  </ul>
                  <div class="mt-10">
                     <a href="/privacy-philosophy" onclick="handleNav(event, '/privacy-philosophy')" class="inline-flex items-center gap-2 text-white font-bold hover:underline">
                       ${t('home.privacy_link')} <i data-lucide="arrow-right" class="w-4 h-4"></i>
                     </a>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- FAQ -->
          <section class="py-24 bg-white">
            <div class="max-w-3xl mx-auto px-6">
              <h2 class="text-4xl font-bold text-center mb-12 reveal">${t('home.faq_title')}</h2>
              
              <div class="space-y-4 faq-list">
                <details class="faq-item group glass-panel rounded-2xl bg-gray-50 open:bg-white transition-colors reveal stagger-1">
                  <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6">
                    <span class="text-lg font-bold">${t('home.faq_q1')}</span>
                    <span class="faq-chevron">
                      <i data-lucide="chevron-down" class="w-5 h-5"></i>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <div class="faq-answer-inner text-nexus-muted px-6 pb-6 pt-0">
                      ${t('home.faq_a1')}
                    </div>
                  </div>
                </details>

                <details class="faq-item group glass-panel rounded-2xl bg-gray-50 open:bg-white transition-colors reveal stagger-2">
                  <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6">
                    <span class="text-lg font-bold">${t('home.faq_q2')}</span>
                    <span class="faq-chevron">
                      <i data-lucide="chevron-down" class="w-5 h-5"></i>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <div class="faq-answer-inner text-nexus-muted px-6 pb-6 pt-0">
                      ${t('home.faq_a2')}
                    </div>
                  </div>
                </details>

                <details class="faq-item group glass-panel rounded-2xl bg-gray-50 open:bg-white transition-colors reveal stagger-3">
                  <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6">
                    <span class="text-lg font-bold">${t('home.faq_q3')}</span>
                    <span class="faq-chevron">
                      <i data-lucide="chevron-down" class="w-5 h-5"></i>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <div class="faq-answer-inner text-nexus-muted px-6 pb-6 pt-0">
                      ${t('home.faq_a3')}
                    </div>
                  </div>
                </details>

                <details class="faq-item group glass-panel rounded-2xl bg-gray-50 open:bg-white transition-colors reveal stagger-4">
                  <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6">
                    <span class="text-lg font-bold">${t('home.faq_q4')}</span>
                    <span class="faq-chevron">
                      <i data-lucide="chevron-down" class="w-5 h-5"></i>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <div class="faq-answer-inner text-nexus-muted px-6 pb-6 pt-0">
                      ${t('home.faq_a4')}
                    </div>
                  </div>
                </details>
              </div>
            </div>
          </section>

          <!-- CTA -->
          <section class="py-32 bg-nexus-text text-white relative overflow-hidden">
             <!-- Decorative elements -->
             <div class="absolute top-0 right-0 w-full h-full opacity-20 bg-[url('https://res.cloudinary.com/du5fldub3/image/upload/v1771950089/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/logo-iter1-nobg.png')] bg-no-repeat bg-center bg-contain blur-3xl transform scale-150"></div>
             
             <div class="max-w-4xl mx-auto px-6 text-center relative z-10 reveal">
               <h2 class="text-5xl md:text-6xl font-bold mb-6">${t('home.cta_title')}</h2>
               <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
                 ${t('home.cta_desc')}
               </p>
               <div class="flex justify-center">
                 <a href="/download" onclick="handleNav(event, '/download')" class="px-10 py-4 rounded-full bg-white text-nexus-text font-bold text-lg hover:bg-gray-100 transition-colors flex items-center justify-center gap-2">
                   <i data-lucide="download" class="w-5 h-5"></i> ${t('home.cta_download')}
                 </a>
               </div>
             </div>
          </section>
        `;
      }

      function renderFeatures() {
        app.innerHTML = `
