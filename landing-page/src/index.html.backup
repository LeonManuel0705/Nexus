          <div>
            <h4 class="font-display font-bold text-nexus-text mb-6" data-i18n="footer.company">Company</h4>
            <ul class="space-y-4">
              <li><a href="/about" onclick="handleNav(event, '/about')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="footer.about_us">About Us</a></li>
              <li><a href="mailto:leon.m.toepper@gmail.com" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="footer.contact">Contact</a></li>
              <li><a href="/nutzungsbedingungen" onclick="handleNav(event, '/nutzungsbedingungen')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="footer.terms">Terms of Service</a></li>
              <li><a href="/datenschutz" onclick="handleNav(event, '/datenschutz')" class="text-nexus-muted hover:text-nexus-purple transition-colors" data-i18n="footer.privacy_policy">Privacy Policy</a></li>
            </ul>
