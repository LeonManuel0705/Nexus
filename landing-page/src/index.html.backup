<!doctype html>
<html lang="en">
  <head>
    <!-- ══════════════════════════════════════════════════════════════
         META & SEO
         ══════════════════════════════════════════════════════════════ -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nexus" />
    <meta property="og:title" content="Nexus - The All-in-One Productivity System" />
    <meta property="og:description" content="Nexus combines school, transit, training, and life management in one private, offline-first app. No account, no cloud, no cost." />
    
        <meta property="og:url" content="{DOMAIN_URL}" />
		<meta property="og:image" content="https://res.cloudinary.com/du5fldub3/image/upload/c_fill,w_1200,h_630,g_north/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/screenshots/preview-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		<!-- Open Graph video (may be ignored by many platforms, but valid) -->
		<meta property="og:video" content="https://res.cloudinary.com/du5fldub3/video/upload/w_1200/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/videos/desktop/preview-video.mp4" />
		<meta property="og:video:type" content="video/mp4" />
		<meta property="og:video:width" content="1280" />
		<meta property="og:video:height" content="720" />
		
		<!-- X Player Card -->
		<meta name="twitter:card" content="player" />
		<meta name="twitter:image" content="https://res.cloudinary.com/du5fldub3/image/upload/c_fill,w_1200,h_630,g_north/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/screenshots/preview-image.png" />
		
		<!-- This must be an iframe-friendly HTML page you host -->
		<meta name="twitter:player" content="{DOMAIN_URL}/embed/preview" />
		<meta name="twitter:player:width" content="1280" />
		<meta name="twitter:player:height" content="720" />
		
		<!-- Raw stream URL (MP4) -->
		<meta name="twitter:player:stream" content="https://res.cloudinary.com/du5fldub3/video/upload/w_1200/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/videos/desktop/preview-video.mp4" />
		<meta name="twitter:player:stream:content_type" content="video/mp4" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nexus App Interface" />
    <meta name="description" content="Nexus combines school, transit, training, and life management in one private, offline-first app. No account, no cloud, no cost." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital@0;1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Radio+Canada+Big:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js" integrity="sha384-hJnF5AwidE18GSWTAGHv3ByzzvfNZ1Tcx5y1UUV3WkauuMCEzBJBMSwSt/PUPXnM" crossorigin="anonymous"></script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com/3.4.17" integrity="sha384-igm5BeiBt36UU4gqwWS7imYmelpTsZlQ45FZf+XBn9MuJbn4nQr7yx1yFydocC/K" crossorigin="anonymous"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Radio Canada Big"', 'sans-serif'],
              body: ['"Inclusive Sans"', 'sans-serif'],
            },
            colors: {
              nexus: {
                purple: '#764BA2',
                pink: '#F093FB',
                blue: '#667EEA',
                text: '#1A202C',
                muted: '#64748B',
                surface: 'rgba(255,255,255,0.7)',
              }
            },
            backgroundImage: {
              'gradient-brand': 'linear-gradient(135deg, #667EEA 0%, #764BA2 50%, #F093FB 100%)',
              'gradient-subtle': 'linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%)',
            },
            borderRadius: {
              'xl': '1rem',
              '2xl': '1.5rem', // 24px
              '3xl': '2rem',
            },
            boxShadow: {
              'glass': '0 8px 32px rgba(118, 75, 162, 0.1)',
              'soft': '0 4px 12px rgba(0, 0, 0, 0.05)',
            }
          }
        }
      }
    </script>

    <style>
      /* BASE_STYLES */
      body {
        font-family: 'Inclusive Sans', sans-serif;
        color: #1A202C;
        background-color: #FFFFFF;
        overflow-x: hidden;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }

      /* Allow text selection for inputs, textareas, and code blocks */
      input, textarea, pre, code, [contenteditable="true"], .selectable {
        -webkit-user-select: text;
        -moz-user-select: text;
        -ms-user-select: text;
        user-select: text;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Radio Canada Big', sans-serif;
      }

      /* COMPONENT_STYLES */
      .glass-panel {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px rgba(118, 75, 162, 0.1);
      }

      .text-gradient {
        background: linear-gradient(135deg, #667EEA 0%, #764BA2 50%, #F093FB 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }

      .btn-primary {
        background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
        color: white;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.2);
      }

      .nav-link-active {
        color: #764BA2;
        font-weight: 600;
      }

      /* ANIMATION_STYLES */
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      .stagger-1 { transition-delay: 100ms; }
      .stagger-2 { transition-delay: 200ms; }
      .stagger-3 { transition-delay: 300ms; }
      .stagger-4 { transition-delay: 400ms; }
      .stagger-5 { transition-delay: 500ms; }
      .stagger-6 { transition-delay: 600ms; }

      .float-animation {
        animation: float 6s ease-in-out infinite;
      }

      @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
      }

      /* ══════════════════════════════════════════════════════════════
         HERO BACKGROUND - Static Full Image (No Carousel)
         ══════════════════════════════════════════════════════════════ */
      .hero-bg-container {
        position: absolute;
        inset: 0;
        overflow: hidden;
        z-index: 0;
      }

      /* Soft gradient backdrop to fill any empty space around the image */
      .hero-bg-backdrop {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
          #f8f9ff 0%,
          #f3f0ff 25%,
          #fdf4ff 50%,
          #f0f4ff 75%,
          #faf8ff 100%);
      }

      /* Blurred edge fill using the image itself */
      .hero-bg-blur-fill {
        position: absolute;
        inset: -50px;
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_400,q_auto,f_auto,e_blur:2000/v1771960323/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/hero-background-image-modern-productivity-f22d39.png');
        background-size: cover;
        background-position: top center;
        filter: blur(60px) saturate(1.2);
        opacity: 0.5;
        transform: scale(1.2);
      }

      /* Main hero image - fully visible with contain, anchored to top */
      .hero-bg-image {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
      }

      .hero-bg-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: top center;
        animation: heroImageFloat 20s ease-in-out infinite;
      }

      @keyframes heroImageFloat {
        0%, 100% { transform: scale(1) translateY(0); }
        50% { transform: scale(1.02) translateY(-8px); }
      }

      /* Light scrim overlay for text readability */
      .hero-scrim-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
          rgba(255,255,255,0.6) 0%,
          rgba(255,255,255,0.3) 30%,
          rgba(255,255,255,0.2) 60%,
          rgba(255,255,255,0.5) 100%);
        z-index: 1;
        pointer-events: none;
      }

      .hero-gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
          rgba(102,126,234,0.04) 0%,
          rgba(118,75,162,0.06) 50%,
          rgba(240,147,251,0.04) 100%);
        z-index: 2;
        pointer-events: none;
      }

      /* Hero bottom fade - DISABLED for seamless transition */
      .hero-bottom-fade {
        display: none;
      }

      /* ══════════════════════════════════════════════════════════════
         EXTENDED HERO BACKGROUND - Fixed/Parallax Effect
         Background stays fixed while content scrolls over it
         ══════════════════════════════════════════════════════════════ */
      .hero-extended-wrapper {
        position: relative;
        overflow: visible;
        width: 100%;
        max-width: none;
      }

      /* Fixed background layer - stays in place during scroll (desktop) */
      .hero-extended-bg {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100vw; /* Explicit viewport width — prevents any max-width/padding constraint */
        height: 100vh;
        overflow: hidden;
        z-index: 0;
        pointer-events: none;
        /* Will be clipped by wrapper via JS */
      }

      /* Mobile: Use absolute positioning (iOS Safari doesn't support fixed bg well) */
      @supports (-webkit-touch-callout: none) {
        .hero-extended-bg {
          position: absolute;
          left: 0;
          right: 0;
          width: 100%;
          height: 100%;
        }
      }

      /* Also use media query for touch devices */
      @media (hover: none) and (pointer: coarse) {
        .hero-extended-bg {
          position: absolute;
          left: 0;
          right: 0;
          width: 100%;
          height: 100%;
        }
      }

      /* Gradient backdrop - fills any empty space */
      .hero-extended-bg .extended-backdrop {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
          #f8f9ff 0%,
          #f3f0ff 25%,
          #fdf4ff 50%,
          #f0f4ff 75%,
          #faf8ff 100%);
      }

      /* Blurred edge fill - prevents harsh bars around contained image */
      .hero-extended-bg .extended-blur-fill {
        position: absolute;
        inset: -50px;
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_400,q_auto,f_auto,e_blur:2000/v1771960323/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/hero-background-image-modern-productivity-f22d39.png');
        background-size: cover;
        background-position: top center;
        filter: blur(60px) saturate(1.2);
        opacity: 0.5;
        transform: scale(1.2);
      }

      /* Main hero image - contained, centered, no cropping */
      .hero-extended-bg .extended-image {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
      }

      .hero-extended-bg .extended-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        /* Subtle float animation - no carousel/rotation */
        animation: heroImageFloat 20s ease-in-out infinite;
      }

      /* Light scrim overlay for text readability */
      .hero-extended-bg .extended-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
          rgba(255,255,255,0.6) 0%,
          rgba(255,255,255,0.35) 20%,
          rgba(255,255,255,0.25) 35%,
          rgba(255,255,255,0.3) 50%,
          rgba(255,255,255,0.45) 65%,
          rgba(255,255,255,0.65) 80%,
          rgba(255,255,255,0.85) 100%);
        z-index: 1;
      }

      /* Gradient overlay for brand tint */
      .hero-extended-bg .extended-gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
          rgba(102,126,234,0.04) 0%,
          rgba(118,75,162,0.06) 50%,
          rgba(240,147,251,0.04) 100%);
        z-index: 2;
      }

      /* Fade out at bottom of viewport for smooth transition */
      .hero-extended-bg .extended-bottom-fade {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 70%;
        min-height: 350px;
        background: linear-gradient(180deg,
          transparent 0%,
          rgba(255,255,255,0.08) 10%,
          rgba(255,255,255,0.2) 20%,
          rgba(255,255,255,0.35) 30%,
          rgba(255,255,255,0.5) 40%,
          rgba(255,255,255,0.65) 50%,
          rgba(255,255,255,0.78) 60%,
          rgba(255,255,255,0.88) 70%,
          rgba(255,255,255,0.95) 80%,
          rgba(255,255,255,0.99) 90%,
          #FFFFFF 100%);
        z-index: 3;
      }

      /* Content sections within extended wrapper - transparent bg, above fixed bg */
      .hero-extended-wrapper > section,
      .hero-extended-wrapper .hero-section,
      .hero-extended-wrapper .problem-solution-section {
        position: relative;
        z-index: 1;
        background: transparent !important;
      }

      /* Hide fixed background when scrolled past the extended wrapper */
      .hero-extended-bg.is-hidden {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      /* Subtle animated separator glow between hero and next section */
      .hero-transition-glow {
        position: relative;
        height: 2px;
        width: 100%;
        background: linear-gradient(90deg,
          transparent 0%,
          rgba(102,126,234,0.2) 20%,
          rgba(118,75,162,0.35) 50%,
          rgba(240,147,251,0.2) 80%,
          transparent 100%);
        opacity: 0;
        transform: scaleX(0.6);
        transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        z-index: 10;
      }

      .hero-transition-glow.visible {
        opacity: 1;
        transform: scaleX(1);
      }

      .hero-transition-glow::before {
        content: '';
        position: absolute;
        inset: -8px 0;
        background: linear-gradient(90deg,
          transparent 0%,
          rgba(102,126,234,0.05) 20%,
          rgba(118,75,162,0.1) 50%,
          rgba(240,147,251,0.05) 80%,
          transparent 100%);
        filter: blur(8px);
      }

      /* Scroll-linked hero fade using CSS custom properties */
      .hero-section {
        --hero-opacity: 1;
        --hero-blur-intensity: 1;
        padding-top: 18vh !important;
      }

      .hero-section .hero-bg-image img {
        opacity: var(--hero-opacity);
        transition: opacity 0.1s linear;
      }

      .hero-section .hero-bg-blur-fill {
        opacity: calc(0.5 * var(--hero-blur-intensity));
        transition: opacity 0.1s linear;
      }

      /* Hero entrance animations */
      .hero-entrance {
        opacity: 0;
        transform: translateY(40px);
        animation: heroEnter 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .hero-entrance-delay-1 { animation-delay: 0.1s; }
      .hero-entrance-delay-2 { animation-delay: 0.2s; }
      .hero-entrance-delay-3 { animation-delay: 0.35s; }
      .hero-entrance-delay-4 { animation-delay: 0.5s; }
      .hero-entrance-delay-5 { animation-delay: 0.7s; }

      @keyframes heroEnter {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ══════════════════════════════════════════════════════════════
         SCROLL-DRIVEN SECTION TRANSITIONS
         ══════════════════════════════════════════════════════════════ */
      .scroll-section {
        position: relative;
        transition: background-color 0.6s ease;
      }

      .scroll-section::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease;
        pointer-events: none;
      }

      .scroll-section.in-view::before {
        opacity: 1;
      }

      .section-shift-purple::before {
        background: linear-gradient(180deg, transparent 0%, rgba(118,75,162,0.02) 50%, transparent 100%);
      }

      .section-shift-blue::before {
        background: linear-gradient(180deg, transparent 0%, rgba(102,126,234,0.02) 50%, transparent 100%);
      }

      .section-shift-pink::before {
        background: linear-gradient(180deg, transparent 0%, rgba(240,147,251,0.02) 50%, transparent 100%);
      }

      /* ══════════════════════════════════════════════════════════════
         IMMERSIVE FEATURE PANELS
         ══════════════════════════════════════════════════════════════ */
      .feature-panel {
        position: relative;
        overflow: hidden;
        padding: 2.5rem 0;
      }

      .feature-panel-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }

      @media (max-width: 768px) {
        .feature-panel-content {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }

      .feature-panel-visual {
        position: relative;
        perspective: 1000px;
      }

      .feature-panel-visual img {
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        transform-style: preserve-3d;
      }

      .feature-panel:hover .feature-panel-visual img {
        transform: rotateY(-3deg) rotateX(2deg) scale(1.02);
      }

      .feature-panel-text h3 {
        position: relative;
        display: inline-block;
      }

      .gradient-underline {
        position: relative;
      }

      .gradient-underline::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 60px;
        height: 3px;
        background: linear-gradient(90deg, #667EEA, #764BA2, #F093FB);
        border-radius: 2px;
        transition: width 0.4s ease;
      }

      .feature-panel:hover .gradient-underline::after {
        width: 100%;
      }

      .feature-bullet {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.5rem 0;
      }

      .feature-bullet-icon {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        background: linear-gradient(135deg, #667EEA, #764BA2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
      }

      .feature-bullet-icon svg {
        width: 12px;
        height: 12px;
        color: white;
      }

      /* ══════════════════════════════════════════════════════════════
         DEVICE MOCKUPS - Laptop & Phone Frames
         ══════════════════════════════════════════════════════════════ */

      /* --- Laptop (MacBook-style) --- */
      .device-laptop {
        position: relative;
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
      }

      .device-laptop-screen {
        position: relative;
        background: #1a1a2e;
        border-radius: 12px 12px 0 0;
        padding: 8px 8px 0;
        border: 2px solid #2a2a3e;
        border-bottom: none;
        overflow: hidden;
      }

      .device-laptop-screen img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 6px 6px 0 0;
      }

      .device-laptop-base {
        position: relative;
        height: 14px;
        background: linear-gradient(180deg, #2a2a3e 0%, #1a1a2e 100%);
        border-radius: 0 0 4px 4px;
        margin: 0 -4%;
        border: 2px solid #2a2a3e;
        border-top: 1px solid #333;
      }

      .device-laptop-base::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 20%;
        height: 4px;
        background: #333;
        border-radius: 0 0 4px 4px;
      }

      /* --- Phone (iPhone-style) --- */
      .device-phone {
        position: relative;
        width: 100%;
        max-width: 280px;
        margin: 0 auto;
      }

      .device-phone-frame {
        position: relative;
        background: #1a1a2e;
        border-radius: 32px;
        padding: 12px 10px;
        border: 3px solid #2a2a3e;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(255,255,255,0.05) inset;
      }

      .device-phone-frame::before {
        content: '';
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 30%;
        height: 22px;
        background: #1a1a2e;
        border-radius: 0 0 14px 14px;
        z-index: 10;
      }

      .device-phone-frame img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 22px;
      }

      /* Glow effect behind devices */
      .device-glow {
        position: relative;
      }

      .device-glow::before {
        content: '';
        position: absolute;
        inset: -20%;
        background: radial-gradient(ellipse at center,
          rgba(118, 75, 162, 0.12) 0%,
          rgba(102, 126, 234, 0.06) 40%,
          transparent 70%);
        z-index: -1;
        pointer-events: none;
      }

      @media (max-width: 768px) {
        .device-laptop { max-width: 100%; }
        .device-phone { max-width: 220px; }
      }

      /* ══════════════════════════════════════════════════════════════
         A DAY WITH NEXUS - FULLSCREEN SCROLL STORY
         ══════════════════════════════════════════════════════════════ */
      .day-story-wrapper {
        position: relative;
      }

      /* Each step creates scroll space */
      .day-story-step {
        height: 200vh;
        position: relative;
      }

      /* The sticky viewport that pins the image */
      .day-story-panel {
        position: sticky;
        top: 0;
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      /* Background images with gradient overlays */
      .day-story-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        transition: transform 0.8s ease-out, opacity 0.6s ease-out;
        /* Start slightly transparent for fade-in effect */
        opacity: 0.9;
      }

      /* Fade in to full opacity when panel is in view */
      .day-story-panel.in-view .day-story-bg {
        opacity: 1;
      }

      .day-story-panel:hover .day-story-bg {
        transform: scale(1.02);
      }

      /* Scrim overlay - reduced opacity to show more background image */
      .day-story-bg-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg,
          rgba(255,255,255,0.1) 0%,
          rgba(255,255,255,0.05) 40%,
          rgba(255,255,255,0.05) 60%,
          rgba(255,255,255,0.2) 100%);
        pointer-events: none;
        z-index: 1;
      }

      /* Panel-specific backgrounds using user-selected static images */
      .day-story-panel[data-step="dashboard"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772003381/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/dashboard-00-scene-morning-routine-df75ca.png');
        background-color: #f8faff;
      }

      .day-story-panel[data-step="vbb"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772003382/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/vbb-30-companion-scene-pair-67015d.png');
        background-color: #fdf4ff;
      }

      .day-story-panel[data-step="school"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772003382/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/school-15-scene-modern-german-492f5e.png');
        background-color: #eef2ff;
      }

      .day-story-panel[data-step="tasks"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772003381/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/tasks-13-00-scene-midday-195d1c.png');
        background-color: #f0fdf4;
      }

      .day-story-panel[data-step="training"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772003380/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/training-16-00-companion-scene-cdb1cf.png');
        background-color: #eff6ff;
      }

      .day-story-panel[data-step="review"] .day-story-bg {
        background-image: url('https://res.cloudinary.com/du5fldub3/image/upload/w_1920,q_auto,f_auto/v1772004344/app/c8a21bc7-048b-4475-81e4-39cf5f64b93c/review-22-00-background-cinematic-b6ae11.png');
        background-color: #faf5ff;
      }

      /* No feather gradients needed - sticky panels handle transitions naturally */

      /* Subtle noise overlay for premium feel */
      .day-story-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.02;
        mix-blend-mode: overlay;
        pointer-events: none;
      }

      /* Gradient accent overlay */
      .day-story-gradient-accent {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
          rgba(102,126,234,0.03) 0%,
          rgba(118,75,162,0.05) 50%,
          rgba(240,147,251,0.03) 100%);
        pointer-events: none;
      }

      /* Glass content card */
      .day-story-content {
        position: absolute;
        bottom: 4rem;
        left: 2rem;
        z-index: 10;
        max-width: 480px;
        width: auto;
        padding: 1.25rem 1.5rem;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1.25rem;
        box-shadow: 0 12px 40px rgba(118, 75, 162, 0.12);
        /* Always visible — no fly-in */
        transform: translateY(0);
        opacity: 1;
      }

      @media (min-width: 769px) {
        .day-story-content {
          bottom: 5rem;
          left: 4rem;
        }
      }

      @media (max-width: 768px) {
        .day-story-content {
          bottom: 2rem;
          left: 1rem;
          right: 1rem;
          max-width: none;
          width: auto;
          padding: 1rem 1.25rem;
          border-radius: 1rem;
        }
      }

      .day-story-time-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
        color: white;
        font-family: 'Radio Canada Big', sans-serif;
        font-weight: 700;
        font-size: 0.875rem;
        border-radius: 999px;
        margin-bottom: 0.5rem;
        box-shadow: 0 3px 12px rgba(118,75,162,0.25);
      }

      .day-story-time-badge i {
        width: 1rem;
        height: 1rem;
      }

      .day-story-panel-title {
        font-family: 'Radio Canada Big', sans-serif;
        font-size: 1.375rem;
        font-weight: 700;
        color: #1A202C;
        margin-bottom: 0.25rem;
        line-height: 1.3;
        display: inline;
      }

      .day-story-panel-desc {
        font-size: 0.9375rem;
        color: #475569;
        margin-bottom: 0;
        line-height: 1.5;
        display: inline;
      }

      /* Inline title + desc for compact look */
      .day-story-headline {
        margin-bottom: 0.5rem;
      }

      @media (max-width: 768px) {
        .day-story-time-badge {
          font-size: 0.8125rem;
          padding: 0.3rem 0.625rem;
        }

        .day-story-panel-title {
          font-size: 1.125rem;
        }

        .day-story-panel-desc {
          font-size: 0.875rem;
        }
      }

      /* Details - hidden by default, expandable */
      .day-story-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-height: 300px;
        overflow: hidden;
        opacity: 1;
        margin-top: 0.75rem;
      }

      .day-story-detail-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(248,250,252,0.6);
        border-radius: 0.5rem;
        font-size: 0.8125rem;
        transition: background 0.3s ease;
      }

      .day-story-detail-item:hover {
        background: rgba(243,244,246,0.8);
      }

      .day-story-icon {
        width: 28px;
        height: 28px;
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .day-story-icon svg {
        width: 14px;
        height: 14px;
      }

      /* More/Less toggle button - hidden, always expanded */
      .day-story-more-btn {
        display: none !important;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.5rem;
        margin-left: 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #764BA2;
        background: rgba(118, 75, 162, 0.08);
        border: none;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .day-story-more-btn:hover {
        background: rgba(118, 75, 162, 0.15);
        color: #667EEA;
      }

      .day-story-more-btn svg {
        width: 12px;
        height: 12px;
        transition: transform 0.3s ease;
      }

      .day-story-content.expanded .day-story-more-btn svg {
        transform: rotate(180deg);
      }

      .day-story-more-btn .more-text { display: inline; }
      .day-story-more-btn .less-text { display: none; }
      .day-story-content.expanded .day-story-more-btn .more-text { display: none; }
      .day-story-content.expanded .day-story-more-btn .less-text { display: inline; }

      /* Scroll indicator */
      .day-story-scroll-hint {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: rgba(100,116,139,0.6);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        animation: pulseDown 2s ease-in-out infinite;
      }

      @keyframes pulseDown {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.6; }
        50% { transform: translateX(-50%) translateY(8px); opacity: 1; }
      }

      /* Progress indicator */
      .day-story-progress {
        position: fixed;
        right: 2rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        z-index: 100;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .day-story-wrapper:hover .day-story-progress,
      .day-story-progress.visible {
        opacity: 1;
      }

      @media (max-width: 768px) {
        .day-story-progress {
          display: none;
        }
      }

      .day-story-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(148,163,184,0.3);
        transition: all 0.3s ease;
        cursor: pointer;
      }

      .day-story-dot.active {
        background: linear-gradient(135deg, #667EEA, #764BA2);
        transform: scale(1.3);
        box-shadow: 0 0 12px rgba(118,75,162,0.4);
      }

      .day-story-dot:hover {
        background: rgba(118,75,162,0.5);
        transform: scale(1.2);
      }

      /* ══════════════════════════════════════════════════════════════
         FAQ SMOOTH ACCORDION
         ══════════════════════════════════════════════════════════════ */
      .faq-item {
        overflow: hidden;
      }

      .faq-chevron {
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        flex-shrink: 0;
      }

      .faq-item[open] .faq-chevron {
        transform: rotate(180deg);
      }

      .faq-answer {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 0.3s ease;
        opacity: 0;
      }

      .faq-item[open] .faq-answer {
        grid-template-rows: 1fr;
        opacity: 1;
      }

      .faq-answer-inner {
        overflow: hidden;
      }

      /* ══════════════════════════════════════════════════════════════
         PRIVACY SWITCHING HIGHLIGHT SECTION
         Premium animated section with scroll-driven highlighting
         ══════════════════════════════════════════════════════════════ */
      .privacy-highlight-section {
        position: relative;
        min-height: 100vh;
        padding: 6rem 0;
        background: linear-gradient(180deg, #f9fafb 0%, #ffffff 50%, #f9fafb 100%);
      }

      .privacy-highlight-container {
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Desktop: Two column layout with sticky left */
      @media (min-width: 768px) {
        .privacy-highlight-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 4rem;
          align-items: start;
        }

        .privacy-highlight-sticky {
          position: sticky;
          top: 8rem;
        }

        /* Give each item enough scroll height for story-like slow progression (~80vh scroll per item) */
        .privacy-highlight-item {
          min-height: 80vh;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;
        }

        .privacy-highlight-item:last-child {
          min-height: 50vh;
        }
      }

      /* Left column intro */
      .privacy-highlight-intro h2 {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        color: #1A202C;
      }

      .privacy-highlight-intro p {
        font-size: 1.125rem;
        color: #64748B;
        line-height: 1.7;
        max-width: 28rem;
      }

      /* Animated gradient bar indicator */
      .privacy-indicator-track {
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 100%;
        background: rgba(148, 163, 184, 0.15);
        border-radius: 4px;
        overflow: hidden;
      }

      .privacy-indicator-bar {
        position: absolute;
        left: 0;
        width: 100%;
        height: 33.33%;
        background: linear-gradient(180deg, #667EEA, #764BA2, #F093FB);
        border-radius: 4px;
        transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 300ms ease;
        box-shadow: 0 0 20px rgba(118, 75, 162, 0.4);
      }

      /* Right column items */
      .privacy-highlight-items {
        position: relative;
        padding-left: 2rem;
      }

      .privacy-highlight-item {
        position: relative;
        padding: 4rem 0;
        cursor: pointer;
        transition: opacity 300ms ease;
      }

      .privacy-highlight-item:not(:last-child) {
        border-bottom: 1px solid rgba(148, 163, 184, 0.1);
      }

      /* Muted state for non-active items */
      .privacy-highlight-item.muted {
        opacity: 0.4;
      }

      .privacy-highlight-item.muted:hover {
        opacity: 0.7;
      }

      /* Item icon */
      .privacy-item-icon {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
                    box-shadow 400ms ease;
      }

      .privacy-highlight-item.active .privacy-item-icon {
        transform: scale(1.1);
        box-shadow: 0 8px 24px rgba(118, 75, 162, 0.25);
      }

      .privacy-item-icon.icon-speed {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.15));
        color: #667EEA;
      }

      .privacy-item-icon.icon-offline {
        background: linear-gradient(135deg, rgba(118, 75, 162, 0.15), rgba(240, 147, 251, 0.15));
        color: #764BA2;
      }

      .privacy-item-icon.icon-secure {
        background: linear-gradient(135deg, rgba(240, 147, 251, 0.15), rgba(102, 126, 234, 0.15));
        color: #F093FB;
      }

      /* Item title */
      .privacy-item-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1A202C;
        margin-bottom: 0.5rem;
        position: relative;
        display: inline-block;
        transition: color 300ms ease;
      }

      /* Gradient underline for active item */
      .privacy-item-title::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0;
        height: 3px;
        background: linear-gradient(90deg, #667EEA, #764BA2, #F093FB);
        border-radius: 3px;
        transition: width 500ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .privacy-highlight-item.active .privacy-item-title::after {
        width: 100%;
      }

      .privacy-highlight-item.active .privacy-item-title {
        background: linear-gradient(135deg, #667EEA, #764BA2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Item description - hidden by default, slides in when active */
      .privacy-item-desc {
        font-size: 1rem;
        color: #64748B;
        line-height: 1.6;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-10px);
        transition: max-height 500ms cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 400ms ease 100ms,
                    transform 400ms cubic-bezier(0.22, 1, 0.36, 1) 100ms;
      }

      .privacy-highlight-item.active .privacy-item-desc {
        max-height: 200px;
        opacity: 1;
        transform: translateY(0);
      }

      /* Mobile: Accordion style */
      @media (max-width: 767px) {
        .privacy-highlight-section {
          padding: 4rem 0;
        }

        .privacy-highlight-intro {
          margin-bottom: 3rem;
          text-align: center;
        }

        .privacy-highlight-intro h2 {
          font-size: 2rem;
        }

        .privacy-highlight-intro p {
          max-width: none;
        }

        .privacy-highlight-items {
          padding-left: 1.5rem;
        }

        .privacy-indicator-track {
          width: 3px;
        }

        .privacy-highlight-item {
          padding: 1.5rem 0;
        }

        .privacy-item-icon {
          width: 2.5rem;
          height: 2.5rem;
        }

        .privacy-item-title {
          font-size: 1.125rem;
        }
      }

      /* Subtle background glow for active item */
      .privacy-highlight-item::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 0;
        bottom: 0;
        width: calc(100% + 3rem);
        background: linear-gradient(90deg, rgba(118, 75, 162, 0.03), transparent);
        opacity: 0;
        transition: opacity 400ms ease;
        pointer-events: none;
        border-radius: 0 1rem 1rem 0;
      }

      .privacy-highlight-item.active::before {
        opacity: 1;
      }

      /* Navbar Logic */
      #nav-logo {
        transition: opacity 0.3s ease;
      }

      /* Only hide logo on home page when transparent */
      body.is-home #navbar[data-scroll-effect]:not(.scrolled) #nav-logo {
         /* We actually want the logo visible always based on design spec "logo uploaded for Nexus website (transparent background)"
            and "If the navbar in the design is not transparent, display the logo".
            However, standard pattern suggests keeping it visible for brand recognition unless it clashes.
            Given the white background design, we'll keep the logo visible always but change navbar background.
         */
      }

      /* Navbar: floating overlay on its own GPU layer */
      #navbar {
        background-color: transparent;
        will-change: transform;
        transform: translate3d(0, 0, 0);
        transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
                    background-color 300ms ease,
                    backdrop-filter 300ms ease,
                    box-shadow 300ms ease;
      }

      /* Home page: navbar slides up out of view at top */
      body.is-home #navbar:not(.scrolled) {
        transform: translate3d(0, -100%, 0);
        pointer-events: none;
      }

      body.is-home #navbar.scrolled {
        transform: translate3d(0, 0, 0);
        pointer-events: auto;
      }

      /* Remove top padding on main container for home page so hero is flush */
      body.is-home #app {
        padding-top: 0 !important;
      }

      /* Hero content: constant padding, no transitions (navbar floats above) */
      .hero-content-wrapper {
        padding-bottom: 4rem !important;
        padding-top: calc(15vh + env(safe-area-inset-top, 0px)) !important;
      }

      /* Scrolled navbar: frosted glass background */
      #navbar.scrolled {
        background-color: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      /* Soft blurred fade at bottom edge — tall gradient, no hard cutoff */
      #navbar::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 60px;
        transform: translateY(100%);
        background: linear-gradient(to bottom,
          rgba(255,255,255,0.35) 0%,
          rgba(255,255,255,0.15) 30%,
          rgba(255,255,255,0.05) 60%,
          transparent 100%
        );
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
        opacity: 0;
        transition: opacity 300ms ease;
        pointer-events: none;
      }

      #navbar.scrolled::after {
        opacity: 1;
      }

      /* Mobile Menu */
      #mobile-menu {
        background: rgba(255,255,255,0.98);
        backdrop-filter: blur(16px);
      }
    </style>
