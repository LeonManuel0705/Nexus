    </footer>

    <!-- ══════════════════════════════════════════════════════════════
         DATA & ROUTING
         ══════════════════════════════════════════════════════════════ -->
    <script id="content" type="application/json">{
    "company": "content/company.json",
    "assets": "content/assets.json",
    "i18n_de": "content/i18n-de.json",
    "i18n_en": "content/i18n-en.json"
}</script>

<script id="main_script">
const data = JSON.parse(document.getElementById('content').textContent);
      const app = document.getElementById('app');
      document.getElementById('year').textContent = new Date().getFullYear();

      // ─── i18n ───────────────────────────────────────────────────
      const translations = { de: data.i18n_de, en: data.i18n_en };
      let currentLang = localStorage.getItem('nexus-lang') || (navigator.language.startsWith('de') ? 'de' : 'de'); // default: German

      function t(key) {
        const keys = key.split('.');
        let val = translations[currentLang];
        for (const k of keys) { val = val?.[k]; }
        if (val !== undefined) return val;
        // Fallback to English
        let fallback = translations['en'];
        for (const k of keys) { fallback = fallback?.[k]; }
        return fallback || key;
      }

      function setLanguage(lang) {
        currentLang = lang;
        localStorage.setItem('nexus-lang', lang);
        // Update static nav/footer text
        updateStaticText();
        // Re-render current page
        render(location.pathname);
      }

      function updateStaticText() {
        // Nav links and all data-i18n elements
        document.querySelectorAll('[data-i18n]').forEach(el => {
          el.textContent = t(el.dataset.i18n);
        });
        // Language toggle buttons
        const otherLang = currentLang === 'de' ? 'EN' : 'DE';
        const toggle = document.getElementById('lang-toggle');
        if (toggle) toggle.textContent = otherLang;
        document.querySelectorAll('.lang-toggle-mobile').forEach(el => { el.textContent = otherLang; });
      }

      // ─── UTILS ───────────────────────────────────────────────────
      function optimizeUrl(url, width = 800) {
        if (!url || !url.includes('cloudinary.com')) return url;
        return url.replace('/upload/', `/upload/w_${width},q_auto,f_auto/`);
      }

      function scrollToId(id) {
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }

      // ─── ROUTER ───────────────────────────────────────────────────
      const routes = {
        '/': { titleKey: 'nav.home', render: renderHome },
        '/features': { titleKey: 'nav.features', render: renderFeatures },
        '/privacy-philosophy': { titleKey: 'nav.privacy', render: renderPrivacy },
        '/download': { titleKey: 'nav.download', render: renderDownload },
        '/about': { titleKey: 'nav.about', render: renderAbout },
        '/nutzungsbedingungen': { titleKey: 'terms.nav_title', render: renderTerms },
        '/datenschutz': { titleKey: 'privacy_policy.nav_title', render: renderPrivacyPolicy },
      };

      const siteName = data.company.name;

      function handleNav(e, path) {
        e.preventDefault();
        if (path === location.pathname) return;
        history.pushState({}, '', path);
        render(path);
        
        // Mobile menu handling
        const mobileMenu = document.getElementById('mobile-menu');
        if (!mobileMenu.classList.contains('translate-x-full')) {
          mobileMenu.classList.add('translate-x-full');
        }
      }

      function render(path) {
        const route = routes[path] || routes['/'];
        
        // Update body class for specific styling
        document.body.className = path === '/' ? 'is-home' : '';

        document.title = path === '/' ? siteName : `${siteName} — ${t(route.titleKey)}`;

        // Update active nav
        document.querySelectorAll('[data-nav]').forEach(link => {
          const isActive = link.getAttribute('href') === path;
          link.classList.toggle('nav-link-active', isActive);
          link.setAttribute('aria-current', isActive ? 'page' : 'false');
        });

        scrollTo({ top: 0, behavior: 'instant' });
        route.render();

        lucide?.createIcons();
        initScrollReveal();
        // Reset navbar state for new page (scrollY will be 0 after scrollTo)
        updateNavbar();
      }

      // Event listeners
      addEventListener('popstate', () => render(location.pathname));
      window.handleNav = handleNav;

      // Navbar Scroll
      const nav = document.getElementById('navbar');

      function updateNavbar() {
        const isHome = document.body.classList.contains('is-home');
        const scrolled = window.scrollY > 10;

        nav.classList.toggle('scrolled', window.scrollY > 20);

        // Accessibility: when visually hidden on home page, remove from focus order
        const hidden = isHome && !scrolled;
        nav.setAttribute('aria-hidden', hidden ? 'true' : 'false');
        nav.querySelectorAll('a, button').forEach(el => {
          if (hidden) {
            el.setAttribute('tabindex', '-1');
          } else {
            el.removeAttribute('tabindex');
          }
        });
      }

      window.addEventListener('scroll', updateNavbar, { passive: true });
      // Run on page load so initial state is correct
      updateNavbar();

      // Scroll Reveal with enhanced section transitions
      function initScrollReveal() {
        // Basic reveal observer
        const revealObserver = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('active');
              }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

        // Section background shift observer
        const sectionObserver = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
              } else {
                entry.target.classList.remove('in-view');
              }
            });
          },
          { threshold: 0.2, rootMargin: '-50px' }
        );
        document.querySelectorAll('.scroll-section').forEach(el => sectionObserver.observe(el));

        // Hero background carousel disabled - using static image
        // initHeroCarousel();

        // Extended hero background - dynamic height
        initExtendedHeroBg();

        // Hero scroll transition effect
        initHeroScrollTransition();

        // Day story timeline interaction
        initDayStory();

        // FAQ smooth accordion
        initFaqAccordion();

        // Privacy page switching highlight section
        initPrivacyHighlights();
      }

      // Privacy Page Switching Highlight Interaction
      function initPrivacyHighlights() {
        const container = document.getElementById('privacy-highlights');
        if (!container) return;

        const items = container.querySelectorAll('.privacy-highlight-item');
        const indicator = document.getElementById('privacy-indicator');
        if (!items.length || !indicator) return;

        let activeIndex = 0;
        let lockout = false;
        const LOCKOUT_MS = 200;
        // Trigger line: item activates when its top reaches 60% from viewport top (slower progression)
        const TRIGGER_RATIO = 0.60;

        function setActiveItem(index) {
          if (index === activeIndex || lockout) return;
          lockout = true;
          activeIndex = index;

          items.forEach((item, i) => {
            if (i === index) {
              item.classList.remove('muted');
              item.classList.add('active');
            } else {
              item.classList.remove('active');
              item.classList.add('muted');
            }
          });

          indicator.style.transform = `translateY(${index * 100}%)`;
          setTimeout(() => { lockout = false; }, LOCKOUT_MS);
        }

        const isMobile = window.innerWidth < 768;

        if (!isMobile) {
          let rafPending = false;

          function onScroll() {
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(() => {
              rafPending = false;
              const containerRect = container.getBoundingClientRect();
              // Only run when section is visible
              if (containerRect.bottom < 0 || containerRect.top > window.innerHeight) return;

              const triggerY = window.innerHeight * TRIGGER_RATIO;
              // Walk items in reverse: last item whose top is at or above triggerY wins
              let newIndex = 0;
              items.forEach((item, i) => {
                const top = item.getBoundingClientRect().top;
                if (top <= triggerY) newIndex = i;
              });

              setActiveItem(newIndex);
            });
          }

          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll(); // Run once on init to set correct initial state
        }

        // Click/tap to highlight (mobile & desktop)
        items.forEach((item, i) => {
          item.addEventListener('click', () => {
            setActiveItem(i);
            if (isMobile) {
              item.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        });

        setActiveItem(0);
      }

      // Hero scroll-linked transition effect
      function initHeroScrollTransition() {
        const heroSection = document.getElementById('hero-section');
        const transitionGlow = document.getElementById('hero-transition-glow');
        if (!heroSection) return;

        let ticking = false;

        function updateHeroTransition() {
          const heroRect = heroSection.getBoundingClientRect();
          const heroHeight = heroRect.height;
          const scrolled = -heroRect.top;

          // Calculate progress: 0 at top, 1 when 30% past hero bottom
          const transitionStart = heroHeight * 0.6;
          const transitionEnd = heroHeight * 1.3;
          const progress = Math.max(0, Math.min(1, (scrolled - transitionStart) / (transitionEnd - transitionStart)));

          // Update CSS custom properties for smooth opacity/blur fade
          // Opacity: 1 → 0.85 as user scrolls past
          const opacity = 1 - (progress * 0.15);
          // Blur intensity: 1 → 0.5 as user scrolls past
          const blurIntensity = 1 - (progress * 0.5);

          heroSection.style.setProperty('--hero-opacity', opacity);
          heroSection.style.setProperty('--hero-blur-intensity', blurIntensity);

          // Show transition glow when scrolled past 70% of hero
          if (transitionGlow) {
            const glowThreshold = heroHeight * 0.7;
            transitionGlow.classList.toggle('visible', scrolled > glowThreshold);
          }

          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(updateHeroTransition);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        // Initial call
        updateHeroTransition();
      }

      // Hero background carousel - crossfade every 6-8 seconds
      function initHeroCarousel() {
        const slides = document.querySelectorAll('.hero-bg-slide');
        if (slides.length === 0) return;

        let currentSlide = 0;
        const totalSlides = slides.length;
        const interval = 7000; // 7 seconds

        function nextSlide() {
          slides[currentSlide].classList.remove('active');
          currentSlide = (currentSlide + 1) % totalSlides;
          slides[currentSlide].classList.add('active');
        }

        setInterval(nextSlide, interval);
      }

      // Extended hero background - dynamic height calculation
      function initExtendedHeroBg() {
        const wrapper = document.querySelector('.hero-extended-wrapper');
        const bg = document.querySelector('.hero-extended-bg');
        if (!wrapper || !bg) return;

        let resizeTimeout;
        let ticking = false;

        // Detect if we're on a touch device (mobile Safari fix)
        const isTouchDevice = ('ontouchstart' in window) ||
          (navigator.maxTouchPoints > 0) ||
          window.matchMedia('(hover: none) and (pointer: coarse)').matches;

        // For mobile: use absolute positioning (CSS handles this)
        // For desktop: use fixed positioning with scroll-based visibility

        function updateBgVisibility() {
          if (isTouchDevice) {
            // Mobile: absolute positioning, just update height
            bg.style.height = wrapper.offsetHeight + 'px';
            return;
          }

          // Desktop: fixed background with visibility toggle
          const wrapperRect = wrapper.getBoundingClientRect();
          const wrapperBottom = wrapperRect.bottom;
          const viewportHeight = window.innerHeight;

          // Hide fixed bg when wrapper is scrolled past viewport
          if (wrapperBottom <= 0) {
            bg.classList.add('is-hidden');
          } else {
            bg.classList.remove('is-hidden');
          }

          // Calculate opacity based on scroll progress through wrapper
          // Fade out as we approach the bottom of the wrapper
          const scrollProgress = Math.max(0, Math.min(1,
            1 - (wrapperBottom / viewportHeight)
          ));

          // Start fading when 50% scrolled through wrapper visible area
          // Ease out smoothly to fully transparent before is-hidden kicks in
          if (scrollProgress > 0.5) {
            const fadeProgress = (scrollProgress - 0.5) / 0.5;
            // Use easeInQuad curve for a more natural fade-out
            const easedFade = fadeProgress * fadeProgress;
            bg.style.opacity = 1 - easedFade;
          } else {
            bg.style.opacity = '';
          }

          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(updateBgVisibility);
            ticking = true;
          }
        }

        // Debounced resize handler
        function onResize() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            if (isTouchDevice) {
              bg.style.height = wrapper.offsetHeight + 'px';
            }
            updateBgVisibility();
          }, 100);
        }

        // Initial setup
        updateBgVisibility();

        // Listen for scroll (desktop parallax visibility)
        window.addEventListener('scroll', onScroll, { passive: true });

        // Recalculate on resize
        window.addEventListener('resize', onResize, { passive: true });

        // Also recalculate after images load (they can change section height)
        wrapper.querySelectorAll('img').forEach(img => {
          if (!img.complete) {
            img.addEventListener('load', () => {
              if (isTouchDevice) {
                bg.style.height = wrapper.offsetHeight + 'px';
              }
              updateBgVisibility();
            });
          }
        });

        // Recalculate after fonts load
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => {
            if (isTouchDevice) {
              bg.style.height = wrapper.offsetHeight + 'px';
            }
            updateBgVisibility();
          });
        }
      }

      // Day story sticky scroll interaction (one-time: disables after scrolling through)
      function initDayStory() {
        const steps = document.querySelectorAll('.day-story-step');
        const panels = document.querySelectorAll('.day-story-panel');
        const dots = document.querySelectorAll('.day-story-dot');
        const progressContainer = document.getElementById('day-story-progress');
        if (steps.length === 0) return;

        const wrapper = document.getElementById('day-story-wrapper');
        let storyCompleted = false;

        // Show/hide progress indicator based on wrapper visibility
        if (wrapper && progressContainer) {
          const wrapperObserver = new IntersectionObserver(
            entries => {
              entries.forEach(entry => {
                if (!storyCompleted) {
                  progressContainer.classList.toggle('visible', entry.isIntersecting);
                }
              });
            },
            { threshold: 0.05 }
          );
          wrapperObserver.observe(wrapper);
        }

        // Click interaction for progress dots
        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            steps[index]?.scrollIntoView({ behavior: 'smooth' });
          });
        });

        function disableSticky() {
          storyCompleted = true;
          // Collapse steps to panel height and remove sticky
          steps.forEach(s => { s.style.height = '100vh'; });
          panels.forEach(p => {
            p.style.position = 'relative';
            p.classList.add('in-view');
          });
          // Hide progress dots
          if (progressContainer) progressContainer.classList.remove('visible');
          // Remove scroll listener
          window.removeEventListener('scroll', onScroll);
        }

        function onScroll() {
          if (storyCompleted) return;
          const scrollY = window.scrollY;
          const vh = window.innerHeight;

          // Check if user has scrolled past the last step
          const lastStep = steps[steps.length - 1];
          const lastRect = lastStep.getBoundingClientRect();
          if (lastRect.bottom < vh * 0.5) {
            disableSticky();
            return;
          }

          steps.forEach((step, i) => {
            const rect = step.getBoundingClientRect();
            const panel = step.querySelector('.day-story-panel');

            if (rect.top < vh && rect.bottom > 0) {
              panel.classList.add('in-view');
              dots[i]?.classList.add('active');
            } else {
              panel.classList.remove('in-view');
              dots[i]?.classList.remove('active');
            }
          });
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // FAQ smooth accordion animation
      function initFaqAccordion() {
        document.querySelectorAll('.faq-item').forEach(details => {
          const summary = details.querySelector('summary');
          const answer = details.querySelector('.faq-answer');
          if (!summary || !answer) return;

          summary.addEventListener('click', e => {
            e.preventDefault();

            if (details.open) {
              // Closing: animate first, then remove open
              answer.style.gridTemplateRows = '0fr';
              answer.style.opacity = '0';
              setTimeout(() => {
                details.open = false;
                answer.style.gridTemplateRows = '';
                answer.style.opacity = '';
              }, 400);
            } else {
              // Opening: set open, then animate
              details.open = true;
            }
          });
        });
      }

      // Mobile Menu
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const closeMobileMenuBtn = document.getElementById('close-mobile-menu');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('translate-x-full');
      });
      closeMobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('translate-x-full');
      });

      // ─── PAGE RENDERERS ───────────────────────────────────────

      function renderHome() {
        app.innerHTML = `
          <!-- EXTENDED HERO WRAPPER - Shared background for Hero + Next Section -->
          <div class="hero-extended-wrapper">
            <!-- Shared Background Layer -->
            <div class="hero-extended-bg">
              <div class="extended-backdrop"></div>
