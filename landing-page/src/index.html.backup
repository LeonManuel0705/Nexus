        <div class="border-t border-gray-100 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-sm text-nexus-muted">&copy; <span id="year"></span> Leon Manuel Töpper. <span data-i18n="footer.copyright">All rights reserved.</span></p>
          <div class="flex gap-6">
            <span class="text-sm text-nexus-muted"><span data-i18n="footer.made_with">Made with</span> <i data-lucide="heart" class="inline w-3 h-3 text-nexus-pink"></i> <span data-i18n="footer.in_germany">in Germany</span></span>
          </div>
